[VFS]
email =
password =
centre = Italy Visa Application Center - Almaty
category = D Visa Study
sub_category = Enrollment at Universities
; browser_backend selects which automation engine checker.py uses.
; Valid values: pydoll (Chrome-based, default), camoufox (Firefox-based,
; anti-detection focused).
browser_backend = pydoll

[CHECK]
interval_minutes = 20

[TELEGRAM]
bot_token =
channel_id =

[RELAY]
; Public origin of the deployed relay (the Vercel project), e.g.
;   url = https://visabot-nine.vercel.app
; The bookmarklet talks only to this; the bot token never reaches the browser.
url =
; REQUIRED. Must match RELAY_SECRET in the relay's environment.
; Generate with:
;   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
;
; Keep this SEPARATE from bot_token. User keys are derived from this secret, so
; if the two were the same, rotating the bot token would invalidate every
; issued bookmarklet at once -- which is exactly the cost that makes people
; postpone rotating a leaked token. Separate secrets make rotation free.
secret =
; Telegram username of YOUR bot, without the @. The guide page tells users to
; press Start on it. Defaults to vfsreg_bot if left empty -- set this when
; running your own bot, or the page sends your users to somebody else's.
bot_username =
